# Example settings — copy the lines you need into server/.env.
# This file currently documents the Firebase push-notification settings only;
# database, payment, mail and other settings are not listed here.
# Never commit real values or service-account keys.

# --- Firebase Admin (push notifications) ---------------------------------
# Primary Firebase project. Credentials for any other project are rejected.
FIREBASE_PROJECT_ID=reward-planners-2324d

# Keyless Google Application Default Credentials (recommended; the
# organisation blocks service-account key creation). When set, key settings
# below are ignored. ADC sources, in google-auth-library order:
#   - GOOGLE_APPLICATION_CREDENTIALS (workload identity federation config)
#   - gcloud auth application-default login
#       --impersonate-service-account=firebase-adminsdk-fbsvc@reward-planners-2324d.iam.gserviceaccount.com
#   - the metadata server on Cloud Run / Compute Engine / GKE
FIREBASE_CREDENTIAL_MODE=application_default
# GOOGLE_APPLICATION_CREDENTIALS=

# Only when an administrator-approved key exists (leave FIREBASE_CREDENTIAL_MODE unset):
# FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json   # relative to server/
# FIREBASE_SERVICE_ACCOUNT=                                            # inline JSON (legacy)

# Previous Firebase project, for devices still on older app builds.
# The id alone lets token registrations record the project; sending to those
# devices also needs a key for that project.
FIREBASE_LEGACY_PROJECT_ID=rewardplanners-ebbe4
# FIREBASE_LEGACY_SERVICE_ACCOUNT_PATH=

# --- Notification manager -----------------------------------------------
NOTIFICATION_TEST_USER_IDS=
NOTIFICATION_PROMO_DAILY_CAP=2
NOTIFICATION_ANNOUNCEMENT_DAILY_CAP=2
NOTIFICATION_LARGE_SEND_THRESHOLD=200
NOTIFICATION_CAMPAIGN_BATCH_SIZE=100
NOTIFICATION_IMAGE_HOSTS=cdn.rewardplanners.com
NOTIFICATION_RM_SEND_ENABLED=true
NOTIFICATION_RM_GLOBAL_SENDER_IDS=
# NOTIFICATION_EMPLOYEE_TIMEZONE=Asia/Kolkata

# Local development only: scheduled jobs (including the campaign worker) stay
# off unless enabled. In production (NODE_ENV not development/test) they run.
ENABLE_LOCAL_SCHEDULED_JOBS=false
