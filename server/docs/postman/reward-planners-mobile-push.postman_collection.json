{
  "info": {
    "name": "Reward Planners - Mobile Push Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "APIs the React Native app uses for push notifications. Run \"Login\" first: it stores accessToken/refreshToken. See docs/mobile-push-api.md."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "login",
      "value": "employee@company.com"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "fcmToken",
      "value": "paste-a-TEST-device-token-here"
    },
    {
      "key": "firebaseProjectId",
      "value": "reward-planners-2324d"
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "beforeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Session",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"success\", () => pm.expect(body.success).to.eql(true));",
                  "if (body.accessToken) pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set(\"refreshToken\", body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"success\", () => pm.expect(body.success).to.eql(true));",
                  "if (body.accessToken) pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "if (body.refreshToken) pm.collectionVariables.set(\"refreshToken\", body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Logout (this device)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\",\n  \"fcm_token\": \"{{fcmToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Stops pushes to this device only. Without fcm_token every device of the employee is signed out of pushes."
          }
        }
      ]
    },
    {
      "name": "2. Device registration",
      "item": [
        {
          "name": "Register / update FCM token",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcm_token\": \"{{fcmToken}}\",\n  \"device_platform\": \"android\",\n  \"firebase_project_id\": \"{{firebaseProjectId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/update-fcm-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "update-fcm-token"
              ]
            },
            "description": "Call after every login, on app start and on onTokenRefresh."
          }
        }
      ]
    },
    {
      "name": "3. Inbox",
      "item": [
        {
          "name": "List (first page)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"success\", () => pm.expect(body.success).to.eql(true));",
                  "if (Array.isArray(body.data) && body.data.length) {",
                  "  pm.collectionVariables.set(\"notificationId\", String(body.data[0].notification_id));",
                  "  pm.collectionVariables.set(\"beforeId\", String(body.data[body.data.length - 1].notification_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/my-notification?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "my-notification"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "List (next page)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/my-notification?limit=20&before_id={{beforeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "my-notification"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "before_id",
                  "value": "{{beforeId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Unread badge",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/notification-badge",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "notification-badge"
              ]
            }
          }
        },
        {
          "name": "Mark one as read",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/read/{{notificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "read",
                "{{notificationId}}"
              ]
            }
          }
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/read-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "read-all"
              ]
            }
          }
        },
        {
          "name": "Report tap (opened)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_state\": \"background\",\n  \"outcome\": \"opened_target\",\n  \"destination_type\": \"product\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/notification/{{notificationId}}/opened",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "{{notificationId}}",
                "opened"
              ]
            }
          }
        },
        {
          "name": "Delete one",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/{{notificationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "{{notificationId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Preferences",
      "item": [
        {
          "name": "Get preferences",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/notification/preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "preferences"
              ]
            }
          }
        },
        {
          "name": "Update preferences",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"en\",\n  \"marketing_enabled\": false,\n  \"engagement_enabled\": false,\n  \"quiet_hours_start\": \"22:00\",\n  \"quiet_hours_end\": \"07:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/notification/preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notification",
                "preferences"
              ]
            }
          }
        }
      ]
    }
  ]
}
