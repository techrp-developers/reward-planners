# Zoho Sign OAuth credentials. Keep these server-side and never expose them in Vite/client env files.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
ZOHO_GENERATED_TOKEN=1000.8d22d9df88e0c912186c518851ad5d3b.3d0e32e5a82322092551a796bf579e1b

# ID of the reusable agreement template containing a SIGN role and signature fields.
ZOHO_SIGN_TEMPLATE_ID=

# Zoho data centre: in, com, eu, jp, com.au, zohocloud.ca, or sa.
ZOHO_SIGN_DC=in

# Exact permitted onboarding callback URL(s), comma-separated when needed.
CLIENT_APP_URL=https://rewardplanners.com/crm/client-onboarding
