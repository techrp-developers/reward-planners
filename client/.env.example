# Target for the legacy /api/* proxy (CRM etc.) in dev. Points at
# production/staging by default - see vite.config.ts.
VITE_API_URL=https://rewardplanners.com/api

# Flea Market is currently served by the local Node backend (port 5000), not
# by the deployed /api/crm service. Override this when that API is deployed.
VITE_FLEA_MARKET_API_URL=http://localhost:5000/api/flea-market

# Target for the /api/flea-market proxy in dev (see vite.config.ts).
# The Flea Market backend (server/app.js) only runs locally today, so this
# defaults to the local server. Override if your local server runs elsewhere,
# e.g. a different port, or the dev machine's LAN IP when testing from a
# tablet/POS device on the same network:
# VITE_DEV_API_PROXY_TARGET=http://192.168.1.42:5000
VITE_DEV_API_PROXY_TARGET=http://localhost:5000
