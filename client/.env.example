# API environment selection and URLs are defined in
# src/common/config/serverConfig.ts.

# Optional target for development proxy traffic (see vite.config.ts).
# Override if your local server runs elsewhere,
# e.g. a different port, or the dev machine's LAN IP when testing from a
# tablet/POS device on the same network:
# VITE_DEV_API_PROXY_TARGET=http://192.168.1.42:5000
VITE_DEV_API_PROXY_TARGET=https://rewardplanners.com

# Public CDN base used to display R2 object keys returned by content APIs.
VITE_R2_PUBLIC_BASE=https://cdn.rewardplanners.com
